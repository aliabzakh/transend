# Copy to .env. Never commit .env. Testnet only.
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Written by `npm run deploy:testnet`
CONTRACT_ID=
USDC_ASSET=
USDC_CONTRACT_ID=
ISSUER_SECRET=      # issues the demo USDC (added to the PRD list: sender wallets need testnet USDC)
ADMIN_SECRET=
VERIFIER_SECRET=
SPONSOR_SECRET=

# Server-side secrets for the web app (generate your own long random values)
KEY_ENCRYPTION_KEY=
PIN_PEPPER=
SESSION_SECRET=
ADMIN_PASSWORD=
DATABASE_URL=            # local: postgres://localhost:5432/transend; deploy: the Neon URL
CRON_SECRET=             # Vercel cron calls /api/cron/forecast with it

# Pricing (demo rate is labelled "demo rate" in the UI, never presented as live)
DEMO_RATE_CAD_USD=0.7077
FX_MARKUP_PCT=2.2
FLAT_FEE_CAD=1.49
MIN_TOPUP_CAD=100

# Savings ("Grow"). Demo rate only, never a real return.
DEMO_APY_BPS=400
MIN_STAKE_USD=10
MIN_LIQUID_USD=100
MAX_STAKED_TOTAL_USD=5000
DEMO_YIELD_SPEEDUP=1

# Cash-demand forecast: rules (baseline) or model (trained, only if it beats the baseline)
FORECAST_MODEL_MODE=rules
